# ==========================================
# SHAXSIY AI TELEGRAM BOT SOZLAMALARI
# ==========================================

# 1. Telegram Bot Token (@BotFather dan olingan)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Google Gemini API Kaliti (https://aistudio.google.com/ dan bepul olinadi)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Model nomi (gemini-2.0-flash, gemini-1.5-flash yoki gemini-1.5-pro)
AI_MODEL=gemini-2.0-flash

# 4. Web server porti
PORT=3000

# 5. Telegram WebApp (Mini App) URL manzili (ixtiyoriy, agar lokal bo'lsa: http://localhost:3000)
WEBAPP_URL=http://localhost:3000
